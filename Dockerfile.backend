FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai

WORKDIR /app

COPY requirements.txt ./
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir --timeout 120 --retries 10 \
    --index-url "$PIP_INDEX_URL" -r requirements.txt

COPY app.py dingtalk_auth.py gpo_password_policy.py gpo_endpoint_policy.py ad_precreate.py ad_bulk_delete.py ./

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/api/admin/check', timeout=3)" || exit 1

CMD ["gunicorn", \
     "-b", "0.0.0.0:5000", \
     "-w", "4", \
     "--threads", "2", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "app:app"]
