FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai

WORKDIR /app

COPY requirements.txt ./
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir --disable-pip-version-check --timeout 30 --retries 3 \
    --index-url "$PIP_INDEX_URL" -r requirements.txt

ARG VPN_BROWSER=0
ARG PLAYWRIGHT_DOWNLOAD_HOST
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN if [ "$VPN_BROWSER" = "1" ]; then \
        pip install --no-cache-dir --disable-pip-version-check --timeout 30 --retries 3 \
            --index-url "$PIP_INDEX_URL" playwright==1.58.0 && \
        python -m playwright install --with-deps --only-shell chromium && \
        rm -rf /var/lib/apt/lists/*; \
    fi

COPY app.py dingtalk_auth.py gpo_password_policy.py gpo_endpoint_policy.py ad_precreate.py ad_bulk_delete.py account_notifications.py vpn_router.py ./

COPY pc_deploy ./pc_deploy

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/api/admin/check', timeout=3)" || exit 1

CMD ["gunicorn", \
     "-b", "0.0.0.0:5000", \
     "-w", "4", \
     "--threads", "2", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "app:app"]
