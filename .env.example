# 在服务器保存为 /app/employee_register/be/.env，不要覆盖原 config.py。
# 不使用钉钉时保持关闭；启用时填写应用信息与真实回调地址。
DINGTALK_LOGIN_ENABLED=false
DINGTALK_LOGIN_CLIENT_ID=
DINGTALK_LOGIN_CLIENT_SECRET=
DINGTALK_LOGIN_REDIRECT_URI=http://ad.wfq.com/api/admin/dingtalk/callback

# 仅兼容旧版预建页面；新版在页面填写本批次密码，无需配置此项。
AD_PRECREATE_DEFAULT_PASSWORD=

# GPO 接入与写入分别启用；默认不连接 SYSVOL，也不允许写入。
GPO_PASSWORD_POLICY_ENABLED=false
GPO_PASSWORD_POLICY_WRITE_ENABLED=false
GPO_PASSWORD_POLICY_GUID=31b2f340-016d-11d2-945f-00c04fb984f9
# 留空使用 AD_SERVER 和系统 CA；私有 CA 可放在持久化 instance 目录中。
# 服务器名须匹配域控证书，且与现有 AD 配置指向同一域控。
# 批量删除也复用以下主机名及 CA 配置，并要求能够验证所有域控的 LDAPS 证书。
GPO_LDAP_SERVER=
GPO_LDAP_CA_CERTS_FILE=
# 留空复用 AD_BIND_USER / AD_BIND_PASSWORD；DN 绑定账号须另填 UPN 或 DOMAIN\user。
GPO_SMB_USERNAME=
GPO_SMB_PASSWORD=

# 设备策略使用三个独立 GPO，预先链接到域根；不复用上面的密码策略 GUID。
GPO_ENDPOINT_POLICY_ENABLED=false
GPO_ENDPOINT_POLICY_WRITE_ENABLED=false
GPO_ENDPOINT_LOCK_GUID=
GPO_ENDPOINT_USB_GUID=
GPO_ENDPOINT_SOFTWARE_GUID=
# 三个 GPO 均须绑定仅含 ProductType=1 查询的 WMI 筛选，排除域控和服务器。
# 软件来源白名单，例如 \\files.wfq.com\Software。域用户只读，发布管理员可写。
GPO_SOFTWARE_SOURCE_ROOT=
